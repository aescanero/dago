{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dago.dev/schemas/patterns/nodes/react.json",
  "title": "ReAct Pattern",
  "description": "Loop de reasoning + acting: Think → Act (tool) → Observe → Repeat",
  "type": "object",
  "required": ["pattern", "config"],
  "properties": {
    "pattern": { "type": "string", "const": "react" },
    "config": {
      "type": "object",
      "required": ["model", "tools", "max_iterations"],
      "properties": {
        "model": { "type": "string" },
        "system_prompt": { "type": "string" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "server"],
            "properties": {
              "type": { "type": "string", "enum": ["mcp", "api"] },
              "server": { "type": "string" }
            }
          }
        },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "stop_condition": { "type": "string", "default": "final_answer" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "thought_visibility": { "type": "string", "enum": ["full", "final_only"], "default": "full" }
      }
    }
  }
}
