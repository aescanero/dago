{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dago.dev/schemas/patterns/nodes/router.json",
  "title": "Router Pattern",
  "description": "Analiza input y produce decisión de routing",
  "type": "object",
  "required": ["pattern", "config"],
  "properties": {
    "pattern": { "type": "string", "const": "router" },
    "config": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["deterministic", "llm", "hybrid"] },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "route"],
            "properties": {
              "condition": { "type": "string" },
              "route": { "type": "string" }
            }
          }
        },
        "llm_fallback": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "system_prompt": { "type": "string" },
            "routes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
