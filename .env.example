# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dago
POSTGRES_PASSWORD=dago_dev
POSTGRES_DB=dago

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Auth Server
AUTH_SERVER_URL=http://localhost:8081
JWT_SIGNING_KEY=dev-signing-key-change-in-production

# Services
ORCHESTRATOR_PORT=8080
AUTH_SERVER_PORT=8081
CATALOG_PORT=8082
MCP_REGISTRY_PORT=8083
AGENT_REGISTRY_PORT=8084

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Environment
ENV=development
LOG_LEVEL=debug

# Valkey Event Bus
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_DLQ_STREAM=dago.dlq
VALKEY_MAX_RETRIES=3
VALKEY_CONSUMER_IDLE_MS=30000

# Anthropic LLM
ANTHROPIC_BASE_URL=                   # empty: api.anthropic.com; tests: http://localhost:PORT
ANTHROPIC_MAX_RETRIES=2

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434   # default local; tests: http://127.0.0.1:PORT
OLLAMA_DEFAULT_MODEL=mixtral             # Mixtral 8x7B model
